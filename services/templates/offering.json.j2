{
  "name": "{{ model }}",
{%- if display_name %}
  "display_name": "{{ display_name }}",
{%- endif %}
{#- The validator requires a short (<200 char) teaser paragraph, then one or more
    detail paragraphs (separated by '\n\n'). Upstream ships one long paragraph, so
    synthesize a short teaser, keep the upstream text as detail, then append a
    standard UnitySVC gateway paragraph (dual-dialect note for LLMs). #}
{%- set _teaser = (display_name | default(model, true)) ~ ' — a ' ~ service_type ~ ' model served by Fireworks AI.' %}
{%- set _detail = description | default('', true) %}
{%- if service_type == 'llm' %}
{%- set _howto = 'Access it through the UnitySVC gateway. The endpoint accepts both OpenAI Chat Completions and Anthropic Messages requests — the gateway auto-detects the dialect, translates it to the upstream, and returns the response in the format you sent. See the code examples for both styles.' %}
{%- else %}
{%- set _howto = 'Access it through the UnitySVC gateway. See the code examples to get started.' %}
{%- endif %}
{%- set _description = _teaser ~ (('\n\n' ~ _detail) if _detail else '') ~ '\n\n' ~ _howto %}
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
  "capabilities": {{ capabilities | default([service_type]) | tojson }},
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "tags": ["ai", "gateway"],
  "details": {
    "model_name": "{{ model_name }}"
{%- if details %}
{%- for key, value in details.items() %},
    "{{ key }}": {{ value | tojson }}
{%- endfor %}
{%- endif %}
{#- R8 (#1768): advertise dual-dialect I/O for LLMs. The gateway auto-detects
    the request dialect and returns the response in the same format. #}
{%- if service_type == 'llm' %},
    "input_formats": ["openai", "anthropic"],
    "output_formats": ["openai_response", "anthropic_response"]
{%- endif %}
  },
  "payout_price": {
    "type": "revenue_share",
    "percentage": "100.00",
    "description": "No platform commission"
  },
  "upstream_access_config": {
    "fireworks_api": {
      "access_method": "http",
      "api_key": "${ secrets.FIREWORKS_API_KEY }",
      "base_url": "https://api.fireworks.ai/inference",
      "rate_limits": [
        {
          "description": "Requests per minute",
          "limit": 60,
          "unit": "requests",
          "window": "minute"
        },
        {
          "description": "Input tokens per minute",
          "limit": 60000,
          "unit": "input_tokens",
          "window": "minute"
        },
        {
          "description": "Output tokens per minute",
          "limit": 6000,
          "unit": "output_tokens",
          "window": "minute"
        }
      ],
      "routing_key": {"model": "{{ offering_name }}"}
{#- R7 (#1768): translate inbound Anthropic Messages requests to the upstream's
    OpenAI-compatible dialect. LLM channels only. #}
{%- if service_type == 'llm' %},
      "request_transformer": {
        "llm_translator": "anthropic_to_openai"
      }
{%- endif %}
    }
  }
}
