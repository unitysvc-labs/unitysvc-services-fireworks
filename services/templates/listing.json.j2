{
  "display_name": "{{ model }}",
  "status": "{{ listing_status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ model }}",
{%- if pricing %}
  "list_price": {
    "type": "{{ pricing.type }}"
{%- if pricing.input is defined %},
    "input": "{{ pricing.input }}",
    "output": "{{ pricing.output }}"
{%- if pricing.cached_input is defined %},
    "cached_input": "{{ pricing.cached_input }}"
{%- endif %}
{%- elif pricing.price is defined %},
    "price": "{{ pricing.price }}"
{%- endif %}
{%- if pricing.description is defined %},
    "description": "{{ pricing.description }}"
{%- endif %}
{%- if pricing.reference is defined %},
    "reference": "{{ pricing.reference }}"
{%- endif %}
  },
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/fireworks.ai",
      "routing_key": {"model": "{{ model_name }}"}
    }
  },
  "documents": {
{%- if is_flux %}
    "Python code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python"
    },
    "Python function calling code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux_fc.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python"
    },
    "JavaScript code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.js.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "javascript"
    },
    "cURL code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.sh.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "bash"
    },
    "connectivity test": {
      "category": "connectivity_test",
      "description": "Connectivity test",
      "file_path": "../../docs/connectivity_flux.sh.j2",
      "is_active": true,
      "is_public": false,
      "mime_type": "bash"
    }
{%- else %}
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Python code example": {
      "$doc_preset": "llm_code_example_openai"
    },
    "Python function calling code example": {
      "$doc_preset": "llm_code_example_fc_requests"
    },
    "JavaScript code example": {
      "$doc_preset": "llm_code_example_javascript"
    },
    "cURL code example": {
      "$doc_preset": "llm_code_example_shell"
    },
    "connectivity test": {
      "$doc_preset": "llm_connectivity"
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
{%- endif %}
  }
}
