{
  "display_name": "{{ model }}",
  "status": "{{ listing_status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138), rendered from the single
      `service_name` the populate script must yield (unitysvc-sellers 0.3.1)
      rather than recomposed here.  The recomposed form was `provider_name` +
      `model` (the SHORT name) rather than `offering_name`, which here is the
      fully-qualified `accounts/fireworks/models/<short>` routing id — one
      more reason for the name to have exactly one source. #}
  "name": "{{ service_name }}",
{%- if pricing %}
  {#- Channel-keyed price: byok is free (the customer's own key pays Fireworks AI
      directly); managed resells Fireworks AI usage at the per-model rate carried
      in the param `pricing`. Channel keys MUST match the offering channels.

      Price-cell copy follows the marketplace description grammar
      (unitysvc/unitysvc#1886, PR #1887):

          <amount> [ ("/"|"per") <unit> ] [ "~"[intent] <badge> ]* [ "|" <note> ]

      The description that matters is the one on the CHANNEL price, not the
      sub-channel ones. CatalogServiceRow hands the whole `list_price` to
      PriceTag, and PriceTag is the only component that parses a description;
      the sub-channel prices reach ChannelDisplay's PriceBadge, which prints
      whatever it is given verbatim. A channel-keyed price carrying neither a
      top-level `description` nor a top-level `price` falls through PriceTag's
      structured branch to `isFree`, so every metered model in this catalog
      renders a green "Free" today.

      Most models here price three ways (input / cached input / output), which
      the grammar refuses to split on purpose: "Pricing Per 1M Tokens (input/
      cached input/output): $0.14 / $0.028 / $0.28" fails the unit test and
      falls through as ONE long unstyled amount. So the cell leads with the
      input rate, names "1M input tokens" as its unit so the figure can't be
      misread as covering all three, and puts the rest in the `|` note, which
      is terminal and taken verbatim — safe for "/" and "per". Two models carry
      a single flat `price` instead and take the simpler branch.

      No badge, deliberately. The row already carries a byok access-method chip
      (AccessMethodBadges renders one per channel type), so a "BYOK" pill here
      would duplicate an affordance the row already has — and the amount beside
      it is the *managed* rate, so a bare `~` badge, which is the green "this
      is a saving" register, would misdescribe the number it sits next to.

      Composed here rather than written into the param file because
      scripts/update_params.py rebuilds `pricing` on the scheduled populate run
      (.github/workflows/populate-services.yml) and would drop a hand-edited
      description.

      `managed_pricing` is `pricing` plus the platform markup — the customer-
      facing rate. `pricing` itself stays upstream, and offering.json.j2 pays
      that out on the managed channel. The cell spans BOTH channels, leading
      with the range rather than picking one; rates join with "/" and NO
      surrounding spaces so the group stays in the amount slot, since the
      parser's separator needs whitespace on both sides and " / " before the
      unit is then the only split point. #}
{%- set _p = managed_pricing or pricing %}
{%- set _byok_note = ' | Free on the byok channel - your own key pays Fireworks AI directly. The managed channel bills UnitySVC at the listed rate.' %}
{%- if _p.input and _p.output %}
{%- set _rates = ('$' ~ _p.input ~ '/$' ~ _p.cached_input ~ '/$' ~ _p.output) if _p.cached_input else ('$' ~ _p.input ~ '/$' ~ _p.output) %}
{%- set _unit = '1M in/cached/out tokens' if _p.cached_input else '1M input/output tokens' %}
{%- set _cell = 'Free - ' ~ _rates ~ ' / ' ~ _unit ~ _byok_note %}
{%- set _managed = _rates ~ ' / ' ~ _unit %}
{%- elif _p.price %}
{%- set _cell = 'Free - $' ~ _p.price ~ ' / 1M tokens' ~ _byok_note %}
{%- set _managed = '$' ~ _p.price ~ ' / 1M tokens' %}
{%- endif %}
  "list_price": {
    "type": "channel",
    "default": "managed",
{%- if _cell %}
    "description": {{ _cell | tojson }},
{%- endif %}
    "channels": {
      "byok": {
        "description": "Free — bring your own Fireworks AI API key; you pay Fireworks AI directly for tokens",
        "price": "0",
        "type": "constant"
      },
      "managed": {{ dict(_p, description=_managed) | tojson if _managed else pricing | tojson }}
    }
  },
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/fireworks.ai",
      "routing_key": {"model": "{{ model_name }}"}
    }
  },
  {#- The embedding and chat shapes are DERIVED from what the service is: its
      capability and the request dialects it accepts (unitysvc/unitysvc#1899).
      The catalog-wide shape lives in unitysvc-data's `llm_example_collection`
      preset, so a new example flavour or a fixed preset reaches this repo on
      the next release rather than through a PR here.

      A collection covers ONE capability, so each branch emits its own call.
      The FLUX branch is left hand-written on purpose: image generation on
      Fireworks is served by repo-local example files with no preset behind
      them, so there is nothing for the collection to derive. -#}
  "documents": {
{%- if is_flux %}
    "Python code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "python"
    },
    "Python function calling code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux_fc.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "python"
    },
    "JavaScript code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.js.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "javascript"
    },
    "cURL code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.sh.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "bash"
    },
    "connectivity test": {
      "category": "connectivity_test",
      "description": "Connectivity test",
      "file_path": "../../docs/connectivity_flux.sh.j2",
      "is_active": true,
      "is_public": false,
      "meta": {"sleep_after_test": 5},
      "mime_type": "bash"
    }
{%- elif service_type == "embedding" %}
    "$llm_example_collection": {
      "capabilities": ["embed"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "sleep": 5
    }
{%- else %}
    {#- The tool-calling example ships only for models whose upstream actually
        accepts tool definitions. `supportsTools` is Fireworks' own per-model
        flag, carried into `details` by scripts/update_params.py, and it is the
        SAME signal that decides `feature:func-call` on the offering — so the
        badge a customer sees and the example they can run cannot disagree.
        Until this gate every chat model shipped the example unconditionally,
        which is how a non-tool model came to answer it with
        `400 invalid request: tool use is not supported by the provided model`.
        Omitted rather than sent as `false`, matching the embedding branch. -#}
    "$llm_example_collection": {
      "capabilities": ["chat"],
      "formats": ["openai", "anthropic"],
      "upstream_dialect": "openai",
{%- if details and details.get('supportsTools') %}
      "tools": true,
{%- endif %}
      "sleep": 5
    }
{%- endif %}
  }
}
