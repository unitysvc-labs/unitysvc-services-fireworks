{
  "display_name": "{{ model }}",
  "status": "{{ listing_status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ model }}",
{%- if pricing %}
  {#- Channel-keyed price: byok is free (the customer's own key pays Fireworks AI
      directly); managed resells Fireworks AI usage at the per-model rate carried
      in the param `pricing`. Channel keys MUST match the offering channels.

      Price-cell copy follows the marketplace description grammar
      (unitysvc/unitysvc#1886, PR #1887):

          <amount> [ ("/"|"per") <unit> ] [ "~"[intent] <badge> ]* [ "|" <note> ]

      The description that matters is the one on the CHANNEL price, not the
      sub-channel ones. CatalogServiceRow hands the whole `list_price` to
      PriceTag, and PriceTag is the only component that parses a description;
      the sub-channel prices reach ChannelDisplay's PriceBadge, which prints
      whatever it is given verbatim. A channel-keyed price carrying neither a
      top-level `description` nor a top-level `price` falls through PriceTag's
      structured branch to `isFree`, so every metered model in this catalog
      renders a green "Free" today.

      Most models here price three ways (input / cached input / output), which
      the grammar refuses to split on purpose: "Pricing Per 1M Tokens (input/
      cached input/output): $0.14 / $0.028 / $0.28" fails the unit test and
      falls through as ONE long unstyled amount. So the cell leads with the
      input rate, names "1M input tokens" as its unit so the figure can't be
      misread as covering all three, and puts the rest in the `|` note, which
      is terminal and taken verbatim — safe for "/" and "per". Two models carry
      a single flat `price` instead and take the simpler branch.

      No badge, deliberately. The row already carries a byok access-method chip
      (AccessMethodBadges renders one per channel type), so a "BYOK" pill here
      would duplicate an affordance the row already has — and the amount beside
      it is the *managed* rate, so a bare `~` badge, which is the green "this
      is a saving" register, would misdescribe the number it sits next to.

      Composed here rather than written into the param file because
      scripts/update_params.py rebuilds `pricing` on the scheduled populate run
      (.github/workflows/populate-services.yml) and would drop a hand-edited
      description. This catalog sets no `payout_price`. #}
{%- set _byok_note = ' Free on the byok channel - bring your own Fireworks AI key and pay Fireworks AI directly.' %}
{%- if pricing.input and pricing.output %}
{%- set _rest = '$' ~ pricing.output ~ ' / 1M output tokens' ~ (', $' ~ pricing.cached_input ~ ' / 1M cached input tokens' if pricing.cached_input else '') ~ '.' %}
{%- set _cell = '$' ~ pricing.input ~ ' / 1M input tokens | ' ~ _rest ~ _byok_note %}
{%- set _managed = '$' ~ pricing.input ~ ' per 1M input tokens, $' ~ pricing.output ~ ' per 1M output tokens' ~ (', $' ~ pricing.cached_input ~ ' per 1M cached input tokens' if pricing.cached_input else '') %}
{%- elif pricing.price %}
{%- set _cell = '$' ~ pricing.price ~ ' / 1M tokens |' ~ _byok_note %}
{%- set _managed = '$' ~ pricing.price ~ ' per 1M tokens' %}
{%- endif %}
  "list_price": {
    "type": "channel",
    "default": "managed",
{%- if _cell %}
    "description": {{ _cell | tojson }},
{%- endif %}
    "channels": {
      "byok": {
        "description": "Free — bring your own Fireworks AI API key; you pay Fireworks AI directly for tokens",
        "price": "0",
        "type": "constant"
      },
      "managed": {{ dict(pricing, description=_managed) | tojson if _managed else pricing | tojson }}
    }
  },
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/fireworks.ai",
      "routing_key": {"model": "{{ model_name }}"}
    }
  },
  "documents": {
{%- if is_flux %}
    "Python code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "python"
    },
    "Python function calling code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux_fc.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "python"
    },
    "JavaScript code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.js.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "javascript"
    },
    "cURL code example": {
      "category": "code_example",
      "description": "Example code to use the model",
      "file_path": "../../docs/code_example_flux.sh.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"sleep_after_test": 5},
      "mime_type": "bash"
    },
    "connectivity test": {
      "category": "connectivity_test",
      "description": "Connectivity test",
      "file_path": "../../docs/connectivity_flux.sh.j2",
      "is_active": true,
      "is_public": false,
      "meta": {"sleep_after_test": 5},
      "mime_type": "bash"
    }
{%- else %}
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_openai", "meta": {"sleep_after_test": 5}}
    },
    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_shell", "meta": {"sleep_after_test": 5}}
    },
    {#- Anthropic-dialect examples (R9): the upstream speaks OpenAI, so
        specs run-tests (local_testing) calls it in OpenAI form, while the
        gateway path speaks Anthropic and exercises the llm_translator. #}
    "Python code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_sdk", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_shell", "meta": {"sleep_after_test": 5}}
    },
    "connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "meta": {"sleep_after_test": 5}}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
{%- endif %}
  }
}
